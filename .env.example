# GEMINI_API_KEY: Required for server-side Gemini AI image classification & listing assistance.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH & SESSION SECRETS (set strong random strings in production)
JWT_SECRET="CHANGE_ME_DEV_JWT_SECRET"
REFRESH_SECRET="CHANGE_ME_DEV_REFRESH_SECRET"

# DATABASE & STORAGE
DATABASE_PATH="./data/scrapwala.db"
UPLOAD_DIR="./storage/private_uploads"

# OPTIONAL EXTERNAL ADAPTERS (leave unset to use documented development adapters)
OTP_PROVIDER="development_adapter"
EMAIL_PROVIDER="development_adapter"
PYTORCH_MODEL_WEIGHTS_PATH=""
